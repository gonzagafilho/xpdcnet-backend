# Porta livre no host (3000/3010 costumam estar ocupadas por apps Next no mesmo servidor)
PORT=3035
NODE_ENV=production
MONGO_URI=mongodb://user:password@127.0.0.1:27017/dcnet?authSource=dcnet
JWT_SECRET=defina_um_segredo_longo_e_unico
JWT_EXPIRES_IN=7d
# MikroTik (enc:v1:…): preferência chave em SystemConfig (POST /system/setup/crypto no painel); se vazia na base, usa-se esta variável.
MIKROTIK_SECRET_KEY=defina_uma_chave_longa_unica_para_criptografia_mikrotik

# production | maintenance (GET /health expõe systemMode)
SYSTEM_MODE=production

# Slug do tenant DCNET na coleção tenants (painel não precisa de x-tenant). Opcional: cabeçalho x-tenant continua a sobrepor.
DEFAULT_TENANT_SLUG=dcnet

# Worker: consolidação financeira → status do cliente → enqueue (intervalo em ms; mínimo 60000)
# FINANCE_ROLLUP_POLL_MS=300000
CUSTOMER_OTP_DEV_MODE=false
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_meta
WHATSAPP_TOKEN=seu_token_meta_whatsapp
WHATSAPP_GRAPH_VERSION=v25.0

# URL pública usada para montar links dos banners enviados (ex.: https://api.exemplo.com)
PUBLIC_API_URL=
